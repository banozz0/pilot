{
  "id": "todo",
  "title": "To-do",
  "icon": "☑️",
  "version": "2.1.0",
  "description": "A to-do list in Hyper+Space and the menu bar: type to add or filter, Return ticks one off, every other action on a key. Due days are optional: with none set it is one tidy list. Kept on this Mac only, no account and no sync.",
  "examples": ["Hyper+Space › To-do, type call mum fri and press Return: added, due Friday, under Upcoming; Return on a to-do ticks it off, ⌘Z puts it back", "Type todo buy milk in Hyper+Space and press Return: Add a to-do: buy milk adds it in one step"],
  "runtime": "process",
  "requires": ["python3"],
  "permissions": {},
  "surfaces": { "page": { "command": "page", "every": 60 }, "bar": { "command": "bar", "every": 60 } },
  "commands": [
    { "name": "todo", "title": "To-do", "mode": "list", "filter": "self", "run": "main.py" },
    { "name": "bar", "title": "To-do in the menu bar", "mode": "no-view", "hidden": true, "run": "main.py" },
    { "name": "page", "title": "To-do page", "mode": "no-view", "hidden": true, "run": "main.py" },
    { "name": "done-list", "title": "Done to-dos", "mode": "no-view", "hidden": true, "run": "main.py" },
    { "name": "add", "title": "Add a to-do", "mode": "no-view", "hidden": true, "keyword": "todo", "run": "main.py" },
    { "name": "done", "title": "Mark a to-do done", "mode": "no-view", "hidden": true, "run": "main.py" },
    { "name": "undone", "title": "Mark a to-do not done", "mode": "no-view", "hidden": true, "run": "main.py" },
    { "name": "delete", "title": "Delete a to-do", "mode": "no-view", "hidden": true, "run": "main.py" },
    { "name": "edit", "title": "Edit a to-do", "mode": "no-view", "hidden": true, "run": "main.py" },
    { "name": "due", "title": "Set a to-do's due day", "mode": "no-view", "hidden": true, "run": "main.py" },
    { "name": "move", "title": "Move a to-do", "mode": "no-view", "hidden": true, "run": "main.py" },
    { "name": "reorder", "title": "Move a to-do on the page", "mode": "no-view", "hidden": true, "run": "main.py" },
    { "name": "undo", "title": "Undo the last change", "mode": "no-view", "hidden": true, "run": "main.py" },
    { "name": "clear-done", "title": "Delete done to-dos", "mode": "no-view", "hidden": true, "run": "main.py" }
  ]
}
