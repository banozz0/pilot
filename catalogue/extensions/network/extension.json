{
  "id": "network",
  "title": "Network",
  "icon": "🌐",
  "version": "1.0.0",
  "description": "Your network in one place: Wi-Fi, local and public IP, the router and DNS; the devices on your network; your Tailscale devices with Connect and Disconnect; the ports your programs hold, freed in a click; your SSH hosts, opened in a terminal; and a speed test on macOS's own networkQuality.",
  "examples": ["Type network overview: your Wi-Fi and its signal, your local and public IP and DNS; Return on Router opens its admin page", "Type kill port, then 3000: the node process holding it; Return quits it. Tailscale devices, SSH hosts and Speedtest are found by their names too"],
  "runtime": "process",
  "requires": ["python3", "lsof", "networkQuality"],
  "permissions": { "clipboard": true, "files": ["~/.ssh/config"], "network": ["api.ipify.org", "mensura.cdn-apple.com", "aaplimg.com"] },
  "surfaces": { "page": { "command": "page", "every": 60 }, "bar": { "command": "bar", "every": 60 } },
  "preferences": [
    { "name": "terminal", "type": "app", "title": "Terminal for SSH",
      "description": "Empty: Ghostty when it is installed, else Terminal." }
  ],
  "commands": [
    { "name": "overview", "title": "Network overview", "icon": "🌐", "mode": "list", "run": "main.py" },
    { "name": "devices", "title": "Devices on the network", "icon": "📡", "mode": "list", "run": "main.py" },
    { "name": "tailscale", "title": "Tailscale devices", "icon": "🛜", "mode": "list", "run": "main.py" },
    { "name": "tailscale-connect", "title": "Connect Tailscale", "icon": "🛜", "mode": "no-view", "run": "main.py" },
    { "name": "tailscale-disconnect", "title": "Disconnect Tailscale", "icon": "🛜", "mode": "no-view", "run": "main.py" },
    { "name": "kill-port", "title": "Ports: kill port", "icon": "🔌", "mode": "list", "run": "main.py" },
    { "name": "ssh-hosts", "title": "SSH hosts", "icon": "🖥️", "mode": "list", "run": "main.py" },
    { "name": "speedtest", "title": "Speedtest", "icon": "⚡", "mode": "detail", "run": "main.py" },
    { "name": "kill", "title": "Quit a port's program", "mode": "no-view", "hidden": true, "run": "main.py" },
    { "name": "ssh-connect", "title": "Connect to SSH host", "mode": "no-view", "hidden": true, "run": "main.py" },
    { "name": "ssh-filter", "title": "Filter SSH hosts", "mode": "no-view", "hidden": true, "run": "main.py" },
    { "name": "speedtest-start", "title": "Run speed test", "mode": "no-view", "hidden": true, "run": "main.py" },
    { "name": "speedtest-stop", "title": "Stop speed test", "mode": "no-view", "hidden": true, "run": "main.py" },
    { "name": "devices-scan", "title": "Look for devices", "mode": "no-view", "hidden": true, "run": "main.py" },
    { "name": "view", "title": "Show a part of the Network page", "mode": "no-view", "hidden": true, "run": "main.py" },
    { "name": "page", "title": "Network page", "mode": "no-view", "hidden": true, "run": "main.py" },
    { "name": "bar", "title": "Tailscale in the menu bar", "mode": "no-view", "hidden": true, "run": "main.py" }
  ]
}
