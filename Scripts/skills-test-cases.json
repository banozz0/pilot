[
  {"id": "theme-list", "skill": "theme", "mode": "theme", "turns": ["/theme which themes do I have, and which one is on now?"]},
  {"id": "theme-new-copy", "skill": "theme", "mode": "theme",
   "turns": ["/theme Make a theme from Tokyo Night with orange accents, call it Ember", "looks good, apply it"]},
  {"id": "theme-apply-shipped", "skill": "theme", "mode": "theme", "turns": ["/theme switch to Akane"]},
  {"id": "theme-apply-deny", "skill": "theme", "mode": "theme", "allow": "deny", "turns": ["/theme apply Tokyo Night"]},
  {"id": "theme-attach", "skill": "theme", "mode": "theme",
   "prep": [["theme", "duplicate", "tokyo-night", "midnight", "Midnight"]], "pictures": ["beach.png", "forest.png"],
   "turns": ["/theme add my pictures in {root}/pictures as wallpapers to my Midnight theme, then show me what applying it would change"]},
  {"id": "theme-restore", "skill": "theme", "mode": "theme",
   "turns": ["/theme apply Tokyo Night", "actually, I want my old look back"]},
  {"id": "theme-delete", "skill": "theme", "mode": "theme",
