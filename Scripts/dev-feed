#!/usr/bin/env python3
"""The dev feed: test builds reach the maintainer's own Pilot through Sparkle, one update per finished batch.

    Scripts/dev-feed publish --release-key [--notes <file>]   build HEAD, sign it, add it to the feed
    Scripts/dev-feed join                                      keep the installed release as the rollback base; point Pilot at the feed
    Scripts/dev-feed rollback                                  put the build before the installed one back, withdraw every build above it
    Scripts/dev-feed leave                                     point the installed Pilot back at the public feed
    Scripts/dev-feed status                                    the installed build, the feed, the server
    Scripts/dev-feed serve --install | --uninstall             the loopback server (a socket-activated launch agent)
The real run and a proof: with --feed, --port and --app all left at their defaults (~/pilot-builds/feed, 47613,
/Applications/Pilot.app), a command acts on the real copy: it writes Pilot's defaults, the launch agent and the real
feed, signs with --release-key only, and quits, swaps and reopens the real Pilot. With all three set to something else
it is a proof: --key-file (a throwaway seed) only, no defaults, no launch agent, the Trash is <app's folder>/Trash, and
nothing with Pilot's bundle id is ever signalled or opened. Any mix is refused. Whether --app is the real copy is
decided by file identity (samefile), never by the path's text, so a differently cased path to it is the real run.

Where it lives: a folder on this Mac served on 127.0.0.1 alone, so no build leaves the Mac and no Pilot user but this
one can reach it. Sparkle 2 fetches the feed and its archives over http or https only (SPUDownloader), so a private
GitHub repo, which needs a token, cannot be a feed; Pilot's NSAllowsLocalNetworking lets it read loopback http. The
server is a launch agent launchd starts per connection (inetd mode), so nothing runs between checks; it answers only
requests whose Host is 127.0.0.1:<port>, so a web page cannot read the feed by DNS rebinding.
How a copy joins: Sparkle reads SUFeedURL from the app's user defaults before Info.plist (SPUUpdater retrieveFeedURL),
so `join` writes it to dev.banozz.pilot's defaults and the installed release follows the feed with no reinstall;
`leave` deletes it. The rollback base is the installed build's own public archive, downloaded from the feed its
Info.plist names with that feed's EdDSA signature, which is checked before it is kept; a base, once kept, is never
replaced. Every build here carries the release EdDSA public key, the one the installed copy trusts.
One update per batch: a publish refuses a commit already published, a dirty tree, a build number Sparkle would not
offer (not above the feed's newest and the installed build), and a HEAD not in origin/main or built on a pushed branch
(its catalogue would read a branch that is deleted once it lands) unless --asked-for-branch names HEAD's branch, for a
branch build Sven asked for. Its item lists what is in the batch: --notes (one line each), else the commit subjects
since the last published commit. The public appcast's newest entry is read before and after.
Rollback: Sparkle only offers higher builds, so `rollback` swaps the bundle itself. Before anything is touched, the
target archive's stored EdDSA signature is checked against the key the installed copy trusts, and the unpacked bundle
must meet the installed copy's identifier and team (codesign -R), and carry the target's build and the same key. The
running copy is found through LaunchServices by bundle id and by each process's program file; an answer that cannot
be read, or another copy of the app running, refuses. Pilot quits on SIGTERM (it undoes its remaps), the replaced
bundle goes to the Trash, the target takes its place and is opened. Every build above the target is withdrawn.
Exit 0 done, 1 refused or failed, 2 a bad argument.
"""
import argparse
import ctypes
import email.utils
import html
import json
import os
import plistlib
import re
import shutil
import signal
import subprocess
import sys
import tempfile
import time
import urllib.parse
import urllib.request
import xml.etree.ElementTree as ET
from pathlib import Path

ROOT = Path(__file__).resolve().parent.parent
SPARKLE_BIN = ROOT / ".build/artifacts/sparkle/Sparkle/bin"
with open(ROOT / "Packaging/Info.plist", "rb") as _f:
    PUBLIC_FEED = plistlib.load(_f)["SUFeedURL"]  # the feed every release reads
DOMAIN = "dev.banozz.pilot"
LABEL = "dev.banozz.pilot.dev-feed"
REAL_APP = Path("/Applications/Pilot.app")
REAL_FEED = Path.home() / "pilot-builds/feed"
REAL_PORT = 47613
KEEP = 5  # live items whose archives stay; older ones are pruned
SPARKLE_NS = "http://www.andymatuschak.org/xml-namespaces/sparkle"
ARCHIVE = re.compile(r"Pilot-\d+(-base)?\.(zip|dmg)")  # the only names a feed.json entry may give

# Ed25519 through CryptoKit, which ships with the Swift toolchain the build already needs: `pub` turns a 32-byte seed
# (Sparkle's key-file format) into its public key, `verify` checks an archive's signature against a public key.
# Keys and seeds come on stdin, never on the command line.
ED25519 = r"""
import CryptoKit
import Foundation
let args = CommandLine.arguments
let input = readLine(strippingNewline: true) ?? ""
guard let key = Data(base64Encoded: input) else { print("bad key"); exit(1) }
if args[1] == "pub" {
    print(try Curve25519.Signing.PrivateKey(rawRepresentation: key).publicKey.rawRepresentation.base64EncodedString())
} else {
    let pub = try Curve25519.Signing.PublicKey(rawRepresentation: key)
    let data = try Data(contentsOf: URL(fileURLWithPath: args[3]), options: .mappedIfSafe)
    print(pub.isValidSignature(Data(base64Encoded: args[2]) ?? Data(), for: data) ? "valid" : "invalid")
}
"""

# The loopback server, run by launchd once per connection with the socket on stdin and stdout (inetd mode).
HANDLER = r"""
import http.server, os, socket, sys
class Feed(http.server.SimpleHTTPRequestHandler):
    def log_message(self, *args): pass
    def send_head(self):
        if self.headers.get("Host") != "127.0.0.1:" + sys.argv[2]:
            self.send_error(421)
            return None
        return super().send_head()
conn = socket.socket(fileno=os.dup(0))
Feed(conn, conn.getpeername(), None, directory=sys.argv[1])
conn.close()
"""

# The running copies of a bundle id, from LaunchServices (NSRunningApplication). Finder is the positive control: a
# shell that cannot see the login session gets an empty list for every id, which must not read as "not running".
RUNNING = r"""
ObjC.import('AppKit');
function run(argv) {
  const list = id => { const a = $.NSRunningApplication.runningApplicationsWithBundleIdentifier(id), out = [];
    for (let i = 0; i < a.count; i++) { const x = a.objectAtIndex(i);
      out.push({pid: x.processIdentifier, bundle: x.bundleURL.isNil() ? null : x.bundleURL.path.js}); }
    return out; };
  return JSON.stringify({finder: list('com.apple.finder').length, apps: list(argv[0])});
}
"""


class Refused(Exception):
    pass


def run(cmd, **kw):
    return subprocess.run(cmd, check=True, text=True, capture_output=True, **kw).stdout.strip()


def git(*args):
    return run(["git", "-C", str(ROOT), *args])


def git_ok(*args):
    return subprocess.run(["git", "-C", str(ROOT), *args], capture_output=True).returncode == 0


def info(app):
    with open(app / "Contents/Info.plist", "rb") as f:
        return plistlib.load(f)


def installed(app):
    """The bundle's Info.plist, or {} when there is none."""
    try:
        return info(app)
    except OSError:
        return {}


def build_number(app):
    return int(installed(app).get("CFBundleVersion", 0))


def same(p, q):
    """File identity. A path that does not exist yet falls back to its case-folded real path, so a doubtful answer
    is 'the same' and a mix of real and proof options is refused rather than taken for a proof."""
    try:
        return os.path.samefile(p, q)
    except OSError:
        return os.path.realpath(p).casefold() == os.path.realpath(q).casefold()


def resolve(a):
    """Sets a.real; the real run uses the canonical paths."""
    real = {"--feed": same(a.feed, REAL_FEED), "--port": a.port == REAL_PORT, "--app": same(a.app, REAL_APP)}
    if all(real.values()):
        a.real, a.app, a.feed = True, REAL_APP, REAL_FEED
    elif not any(real.values()):
        a.real = False
    else:
        raise Refused(f"{', '.join(k for k, v in real.items() if v)} left at the real copy's but "
                      f"{', '.join(k for k, v in real.items() if not v)} not: the real run leaves all three at their defaults, a proof sets all three")


def verify(app):
    run(["codesign", "--verify", "--strict", "--deep", str(app)])


def pack(app, dest):
    run(["ditto", "-c", "-k", "--sequesterRsrc", "--keepParent", str(app), str(dest)])


def ed25519(mode, key, *args):
    with tempfile.NamedTemporaryFile("w", suffix=".swift", delete=False) as f:
        f.write(ED25519)
    try:
        return subprocess.run(["/usr/bin/swift", f.name, mode, *args], input=key + "\n", text=True,
                              capture_output=True, check=True).stdout.strip()
    finally:
        os.unlink(f.name)


def release_key():
    return (ROOT / "Packaging/sparkle-public-key.txt").read_text().strip()


def trusted_key(a):
    """The EdDSA key the installed copy checks updates against; the real copy's must be the release key."""
    key = installed(a.app).get("SUPublicEDKey")
    if not key:
        raise Refused(f"{a.app} names no SUPublicEDKey")
    if a.real and key != release_key():
        raise Refused(f"{a.app} trusts another EdDSA key than Packaging/sparkle-public-key.txt")
    return key


def check_signature(archive, signature, key, whose="the key the installed copy trusts"):
    if not signature or ed25519("verify", key, signature, str(archive)) != "valid":
        raise Refused(f"{archive.name}'s EdDSA signature does not verify against {whose}")


def expect(label, plist, pairs):
    for k, want in pairs:
        if plist.get(k) != want:
            raise Refused(f"{label} has {k} {plist.get(k)}, not {want}")


def checked(name):
    if not isinstance(name, str) or not ARCHIVE.fullmatch(name):
        raise Refused(f"feed.json names the archive {name!r}, not Pilot-<build>[-base].zip|dmg")
    return name


def archive_path(feed, name):
    return feed / checked(name)


def signer(app):
    """(identifier, team) from the bundle's code signature; team is None when it is ad hoc or self-signed."""
    out = subprocess.run(["codesign", "-dv", str(app)], capture_output=True, text=True).stderr
    ident = re.search(r"^Identifier=(.+)$", out, re.M)
    team = re.search(r"^TeamIdentifier=(.+)$", out, re.M)
    if not ident:
        raise Refused(f"{app} carries no code signature")
    return ident[1], (team[1] if team and team[1] != "not set" else None)


def requirement(a):
    """What the target bundle's signature must meet: the installed copy's identifier and Developer ID team. The real
    copy must have a team; a proof's ad hoc stand-in is held to its identifier alone, and says so."""
    ident, team = signer(a.app)
    if team:
        return f'identifier "{ident}" and anchor apple generic and certificate leaf[subject.OU] = "{team}"'
    if a.real:
        raise Refused(f"{a.app} has no Developer ID team to hold a rollback to")
    print(f"proof: {a.app} is ad hoc, so the target is held to identifier {ident} alone (the real run needs its team)")
    return f'identifier "{ident}"'


def check_bundle(fresh, a, target, key):
    req = requirement(a)
    r = subprocess.run(["codesign", "--verify", "--strict", "--deep", f"-R={req}", str(fresh)], capture_output=True, text=True)
    if r.returncode:
        raise Refused(f"the target bundle does not meet {req}: {r.stderr.strip()[-300:]}")
    expect("the target bundle", info(fresh), (("CFBundleIdentifier", installed(a.app).get("CFBundleIdentifier")),
                                              ("CFBundleVersion", str(target["build"])), ("SUPublicEDKey", key)))


def unpack(archive, dest):
    """The Pilot.app inside a zip or a dmg, copied out under dest."""
    if archive.suffix == ".zip":
        run(["ditto", "-x", "-k", str(archive), str(dest)])
    else:
        mnt = dest / "mnt"
        mnt.mkdir()
        run(["hdiutil", "attach", "-nobrowse", "-readonly", "-noautoopen", "-mountpoint", str(mnt), str(archive)])
        try:
            run(["ditto", str(mnt / "Pilot.app"), str(dest / "Pilot.app")])
        finally:
            subprocess.run(["hdiutil", "detach", "-force", str(mnt)], capture_output=True)
    return dest / "Pilot.app"


def feed_url(port):
    return f"http://127.0.0.1:{port}/appcast.xml"


def own_feed(a):
    """The feed the installed copy's Info.plist names; the real copy's must be the public one."""
    url = installed(a.app).get("SUFeedURL", "")
    if a.real and url != PUBLIC_FEED:
        raise Refused(f"{a.app} names the feed {url!r}, not {PUBLIC_FEED}")
    return url


def releases(url):
    """{build: (enclosure url, edSignature)} from an appcast, or None when it cannot be read."""
    try:
        with urllib.request.urlopen(url, timeout=20) as r:
            root = ET.fromstring(r.read())
    except Exception:
        return None
    out = {}
    for item in root.iter("item"):
        enc = item.find("enclosure")
        if enc is None:
            continue
        build = item.findtext(f"{{{SPARKLE_NS}}}version") or enc.get(f"{{{SPARKLE_NS}}}version") or ""
        if build.isdigit():
            out[int(build)] = (enc.get("url"), enc.get(f"{{{SPARKLE_NS}}}edSignature"))
    return out


def public_newest(url=PUBLIC_FEED):
    builds = releases(url)
    return max(builds) if builds else None


def load(feed):
    try:
        return json.loads((feed / "feed.json").read_text())
    except FileNotFoundError:
        return {"base": None, "items": []}


def live(state):
    """The items the feed offers, newest first."""
    return sorted((i for i in state["items"] if not i.get("withdrawn")), key=lambda i: -i["build"])


def appcast(state, port):
    rows = []
    for item in live(state):
        notes = "".join(f"<li>{html.escape(n)}</li>" for n in item["notes"])
        rows.append(f"""    <item>
      <title>{html.escape(item["version"])}</title>
      <pubDate>{item["date"]}</pubDate>
      <sparkle:version>{item["build"]}</sparkle:version>
      <sparkle:shortVersionString>{html.escape(item["version"])}</sparkle:shortVersionString>
      <sparkle:minimumSystemVersion>{item["minimumSystemVersion"]}</sparkle:minimumSystemVersion>
      <description><![CDATA[<h3>In this build ({item["commit"][:7]})</h3><ul>{notes}</ul>]]></description>
      <enclosure url="http://127.0.0.1:{port}/{checked(item["zip"])}" length="{item["length"]}" type="application/octet-stream" sparkle:edSignature="{item["signature"]}"/>
    </item>""")
    return (f'<?xml version="1.0" encoding="utf-8"?>\n<rss version="2.0" xmlns:sparkle="{SPARKLE_NS}">\n'
            f"  <channel>\n    <title>Pilot dev feed</title>\n" + "\n".join(rows) + "\n  </channel>\n</rss>\n")


def save(feed, state, port):
    feed.mkdir(parents=True, exist_ok=True)
    for name, text in (("feed.json", json.dumps(state, indent=2) + "\n"), ("appcast.xml", appcast(state, port))):
        tmp = feed / f".{name}.tmp"
        tmp.write_text(text)
        tmp.replace(feed / name)


def notes_since(base, given):
    if given:
        lines = [l.strip() for l in Path(given).read_text().splitlines() if l.strip()]
    else:
        ancestor = base and git_ok("merge-base", "--is-ancestor", base, "HEAD")
        lines = git("log", "--no-merges", "--format=%s", f"{base}..HEAD" if ancestor else "-20").splitlines()
    if not lines:
        raise Refused("the batch lists nothing; pass --notes with what is in it")
    return lines


def branch_check(a):
    """A batch is landed work: HEAD in origin/main, built where no catalogue branch is baked in (build-app.sh bakes
    any pushed branch but main, and ExtensionCatalogue reads it with no fall back once it is deleted). A branch
    build is published only when --asked-for-branch names HEAD's branch."""
    branch = subprocess.run(["git", "-C", str(ROOT), "symbolic-ref", "--short", "-q", "HEAD"],
                            capture_output=True, text=True).stdout.strip()
    if a.asked_for_branch:
        if a.asked_for_branch != branch:
            raise Refused(f"--asked-for-branch names {a.asked_for_branch}, but HEAD is on {branch or 'no branch'}")
        print(f"branch build of {branch}, as asked: its catalogue reads that branch, and nothing once it is deleted")
        return
    ask = "; a branch build Sven asked for takes --asked-for-branch <its name>"
    if not git_ok("merge-base", "--is-ancestor", "HEAD", "origin/main"):
        raise Refused(f"HEAD is not in origin/main{ask}")
    if branch and branch != "main" and git_ok("rev-parse", "--verify", "-q", f"refs/remotes/origin/{branch}"):
        raise Refused(f"HEAD is on the pushed branch {branch}, so the build would read its catalogue, gone once it is "
                      f"deleted; publish from main or a detached HEAD{ask}")


def publish(a, feed):
    if a.real and not a.release_key:
        raise Refused("the real feed is signed with --release-key; a --key-file is for a proof, with --feed, --port and --app all set")
    if not a.real and not a.key_file:
        raise Refused("a proof signs with a throwaway --key-file, never the release key")
    state = load(feed)
    head = git("rev-parse", "HEAD")
    if git("status", "--porcelain"):
        raise Refused("the tree has uncommitted changes; a batch is a commit")
    if head in {i["commit"] for i in state["items"]}:
        raise Refused(f"{head[:7]} is already published; a new batch needs new commits")
    branch_check(a)
    base = int(next(l for l in (ROOT / "Packaging/build-number-base.txt").read_text().splitlines() if not l.startswith("#")))
    build = int(git("rev-list", "--count", "HEAD")) + base
    current, prior = installed(a.app), live(state)
    floor = max([i["build"] for i in prior[:1]] + [int(current.get("CFBundleVersion", 0))])
    if build <= floor:
        raise Refused(f"build {build} is not above {floor} (the feed's newest or the installed build); Sparkle would not offer it")
    trusted = trusted_key(a)
    if a.key_file:
        sign_key = ed25519("pub", Path(a.key_file).read_text().strip())
    else:
        # Checked before minutes of building: the Keychain's key must be the one Pilot trusts, or every item is refused.
        sign_key = run([str(SPARKLE_BIN / "generate_keys"), "-p"])
        if sign_key != trusted:
            raise Refused("the login Keychain's Sparkle key is not Packaging/sparkle-public-key.txt's")
    notes = notes_since(prior[0]["commit"] if prior else current.get("PilotCommit"), a.notes)
    previous = public_newest()
    tag = git("describe", "--tags", "--abbrev=0", "--match", "v*").lstrip("v")
    version = f"{tag}-dev.{build}"
    if a.built:
        app = a.built
    else:
        env = {k: v for k, v in os.environ.items() if k not in ("SPARKLE_FEED", "PILOT_VERSION")}
        flags = env.get("SWIFTFLAGS", "")
        env.update(PILOT_DEV="1", CONFIG="release", SPARKLE_ED_KEY=trusted, PILOT_VERSION=version,
                   SWIFTFLAGS=flags if re.search(r"(^|\s)-j", flags) else f"{flags} -j 4".strip(),
                   CARGO_BUILD_JOBS=env.get("CARGO_BUILD_JOBS", "4"))
        subprocess.run(["nice", "-n", "10", str(ROOT / "Scripts/build-app.sh")], env=env, check=True)
        app = ROOT / "build/Pilot.app"
    plist = info(app)
    expect(app, plist, (("PilotCommit", head), ("CFBundleVersion", str(build)), ("CFBundleShortVersionString", version),
                        ("SUPublicEDKey", trusted)))
    if plist.get("PilotCatalogueBranch") and plist["PilotCatalogueBranch"] != a.asked_for_branch:
        raise Refused(f"{app} reads branch {plist['PilotCatalogueBranch']}'s catalogue, a branch build nobody asked for")
    feed.mkdir(parents=True, exist_ok=True)
    zipname = f"Pilot-{build}.zip"
    with tempfile.TemporaryDirectory() as tmp:
        staged = Path(tmp) / zipname
        pack(app, staged)
        # Unpacked as Sparkle unpacks a zip (ditto -x -k): the copy must still verify, every helper's signature included.
        run(["ditto", "-x", "-k", str(staged), f"{tmp}/x"])
        verify(f"{tmp}/x/Pilot.app")
        sign = [str(SPARKLE_BIN / "sign_update"), "-p", str(staged)]
        if a.key_file:
            sign[1:1] = ["--ed-key-file", a.key_file]
        signature = run(sign)
        check_signature(staged, signature, sign_key, "the key it was signed with")
        length = staged.stat().st_size
        shutil.move(str(staged), str(feed / zipname))
    state["items"].append({"build": build, "version": version, "commit": head, "date": email.utils.formatdate(usegmt=True),
                           "zip": zipname, "length": length, "signature": signature,
                           "minimumSystemVersion": plist.get("LSMinimumSystemVersion", "27.0"),
                           "notes": notes})
    for old in live(state)[KEEP:]:
        archive_path(feed, old["zip"]).unlink(missing_ok=True)
        state["items"].remove(old)
    save(feed, state, a.port)
    after = public_newest()
    print(f"published {version} (build {build}, {head[:7]}) with {len(notes)} lines in it: {feed / zipname}")
    print(f"feed {feed_url(a.port)} lists {len(live(state))} builds; the newest is offered at the next check")
    if sign_key != trusted:
        print(f"proof: signed with a throwaway key {a.app} does not trust, so a rollback to it is refused")
    if previous is None or after is None:
        print("public feed: could not be read; its newest entry is unchecked")
    elif previous != after:
        print(f"public feed: its newest entry changed from {previous} to {after} during this publish (not by this script)")
    else:
        print(f"public feed: newest entry {after}, unchanged")


def join(a, feed):
    state = load(feed)
    build = build_number(a.app)
    if not build:
        raise Refused(f"no Pilot at {a.app}")
    trusted = trusted_key(a)
    if state["base"]:
        print(f"rollback base stays build {state['base']['build']}: a base, once kept, is never replaced")
    elif build in {i["build"] for i in live(state)}:
        print(f"build {build} is in the feed; no base kept")
    else:
        url = own_feed(a)
        found = (releases(url) or {}).get(build)
        if not found or not found[1]:
            raise Refused(f"build {build} has no signed archive in {url}, so there is nothing to roll back to")
        src, signature = found
        if a.real and not src.startswith("https://"):
            raise Refused(f"the public archive {src} is not https")
        name = f"Pilot-{build}-base{Path(urllib.parse.urlparse(src).path).suffix}"
        dest = archive_path(feed, name)
        feed.mkdir(parents=True, exist_ok=True)
        tmp = feed / f".{name}.tmp"
        try:
            with urllib.request.urlopen(src, timeout=120) as r, open(tmp, "wb") as f:
                shutil.copyfileobj(r, f)
            check_signature(tmp, signature, trusted)
            tmp.replace(dest)
        finally:
            tmp.unlink(missing_ok=True)
        state["base"] = {"build": build, "version": installed(a.app).get("CFBundleShortVersionString"), "zip": name,
                         "signature": signature}
        save(feed, state, a.port)
        print(f"kept build {build}'s signed public archive as the rollback base: {dest}")
    if a.real:
        run(["defaults", "write", DOMAIN, "SUFeedURL", feed_url(a.port)])
        print(f"Pilot now reads {feed_url(a.port)}; Check for updates on General looks now")
    else:
        print(f"proof {a.app}: defaults not written")


def leave(a, feed):
    url = own_feed(a)
    if a.real:
        subprocess.run(["defaults", "delete", DOMAIN, "SUFeedURL"], capture_output=True)
        print(f"Pilot reads its own feed again: {url}")
    else:
        print(f"proof {a.app}: defaults not touched")
    build, newest = build_number(a.app), public_newest(url)
    if newest is None:
        print("public feed: could not be read, so whether it offers an update is unchecked")
    elif build > newest:
        print(f"build {build} is above the public newest {newest}: no public update is offered until a release passes "
              f"{build}; to be on the public line now, rollback to the base first, or install {newest} by hand")
    else:
        print(f"public updates resume: build {build}, public newest {newest}")


def running(a):
    """Pids of the copy at a.app, by file identity: LaunchServices' copies of its bundle id whose bundle is a.app, and
    every process whose program is its main executable. Refuses when either answer cannot be read, or when another
    copy of the same bundle id runs (reopening would bring that one up)."""
    plist = installed(a.app)
    ident, exe = plist.get("CFBundleIdentifier"), a.app / "Contents/MacOS" / plist.get("CFBundleExecutable", "Pilot")
    r = subprocess.run(["/usr/bin/osascript", "-l", "JavaScript", "-e", RUNNING, ident], capture_output=True, text=True)
    try:
        seen = json.loads(r.stdout)
    except ValueError:
        seen = None
    if r.returncode or not seen or not seen["finder"]:
        raise Refused("LaunchServices' running apps cannot be read from here, so whether Pilot runs is unknown")
    pids = set()
    for x in seen["apps"]:
        if not x["bundle"]:
            raise Refused(f"pid {x['pid']} runs {ident} from a bundle that cannot be read")
        if not same(x["bundle"], a.app):
            raise Refused(f"another copy of {ident} runs from {x['bundle']} (pid {x['pid']}); quit it first")
        pids.add(x["pid"])
    lib = ctypes.CDLL("/usr/lib/libproc.dylib", use_errno=True)
    buf = ctypes.create_string_buffer(4096)
    want = os.stat(exe)
    for pid in (int(p) for p in run(["/bin/ps", "-axo", "pid="]).split()):
        if lib.proc_pidpath(pid, buf, len(buf)) > 0:
            try:
                st = os.stat(buf.value)
            except OSError:
                continue
            if (st.st_dev, st.st_ino) == (want.st_dev, want.st_ino):
                pids.add(pid)
        elif lib.proc_name(pid, buf, len(buf)) > 0 and buf.value.decode(errors="replace") == exe.name:
            raise Refused(f"pid {pid} is named {exe.name}, but which program it runs cannot be read")
    return sorted(pids)


def alive(pid):
    try:
        os.kill(pid, 0)
        return True
    except ProcessLookupError:
        return False


def gone(pids, seconds):
    for _ in range(int(seconds * 10)):
        if not any(alive(p) for p in pids):
            return True
        time.sleep(0.1)
    return False


def rollback(a, feed):
    state = load(feed)
    current, base = build_number(a.app), state["base"]
    target = next((i for i in live(state) if i["build"] < current), None) or (base if base and base["build"] < current else None)
    if not target:
        raise Refused(f"nothing older than build {current} is kept in {feed}")
    archive = archive_path(feed, target["zip"])
    key = trusted_key(a)
    # A proof never signals or opens a Pilot. Opened again once it was asked to quit, or the real copy was swapped.
    may_signal = a.real or installed(a.app).get("CFBundleIdentifier") != DOMAIN
    pids, reopen = [], False
    try:
        with tempfile.TemporaryDirectory(dir=a.app.parent) as tmp:
            # Everything about the target is checked before anything about the installed copy changes.
            check_signature(archive, target.get("signature"), key)
            fresh = unpack(archive, Path(tmp))
            check_bundle(fresh, a, target, key)
            pids = running(a)
            if pids and not may_signal:
                raise Refused(f"{a.app} runs with Pilot's bundle id; a proof never quits a Pilot")
            reopen = bool(pids)
            for pid in pids:
                try:
                    os.kill(pid, signal.SIGTERM)
                except ProcessLookupError:
                    pass
            if not gone(pids, 10):
                raise Refused(f"{a.app} did not quit within 10 s of SIGTERM; nothing was replaced")
            # The bundle it replaces goes to the Trash, never straight away.
            trash = Path.home() / ".Trash" if a.real else a.app.parent / "Trash"
            trash.mkdir(exist_ok=True)
            moved = trash / f"Pilot-{current}.app"
            if moved.exists():
                moved = moved.with_name(f"Pilot-{current}-{int(time.time())}.app")
            a.app.rename(moved)
            try:
                fresh.rename(a.app)
            except OSError:
                moved.rename(a.app)
                raise
            reopen = reopen or a.real
            above = [i for i in live(state) if i["build"] > target["build"]]
            for item in above:
                item["withdrawn"] = True
                archive_path(feed, item["zip"]).unlink(missing_ok=True)
            save(feed, state, a.port)
        print(f"rolled back from build {current} to {target['build']} ({target.get('version')}); "
              f"withdrawn from the feed: {', '.join(str(i['build']) for i in above) or 'nothing'}; replaced bundle: {moved}")
    finally:
        if reopen and may_signal:
            if gone(pids, 20):
                subprocess.run(["open", str(a.app)])
                print(f"opened {a.app} (build {build_number(a.app)})")
            else:
                print(f"{a.app} is still running (pid {', '.join(map(str, pids))}); not reopened")


def status(a, feed):
    state = load(feed)
    joined = subprocess.run(["defaults", "read", DOMAIN, "SUFeedURL"], capture_output=True, text=True).stdout.strip()
    served = subprocess.run(["launchctl", "print", f"gui/{os.getuid()}/{LABEL}"], capture_output=True).returncode == 0
    items = live(state)
    newest = f"{items[0]['version']} ({items[0]['commit'][:7]})" if items else "none"
    print(f"mode: {'real' if a.real else 'proof'}; installed: build {build_number(a.app)} at {a.app}")
    print(f"real Pilot reads: {joined or 'its own Info.plist feed (not joined)'}")
    print(f"feed {a.feed}: {len(items)} builds, newest {newest}; base {state['base']['build'] if state['base'] else 'none'}")
    print(f"server: {'loaded' if served else 'not loaded'} (the real one, on 127.0.0.1:{REAL_PORT})")


def serve(a, feed):
    if a.install == a.uninstall:
        raise Refused("serve takes --install or --uninstall")
    if not a.real:
        raise Refused("a proof never loads or removes the launch agent")
    plist = Path.home() / f"Library/LaunchAgents/{LABEL}.plist"
    # Booted out first, so a reinstall over a loaded agent bootstraps the new plist instead of failing on the old one.
    subprocess.run(["launchctl", "bootout", f"gui/{os.getuid()}/{LABEL}"], capture_output=True)
    if a.uninstall:
        plist.unlink(missing_ok=True)
        print(f"server removed ({plist})")
        return
    plist.write_bytes(launch_agent(feed, a.port))
    run(["launchctl", "bootstrap", f"gui/{os.getuid()}", str(plist)])
    print(f"server loaded: {feed_url(a.port)} (launchd starts it per connection)")


def launch_agent(feed, port):
    return plistlib.dumps({
        "Label": LABEL,
        "ProgramArguments": ["/usr/bin/python3", "-I", "-c", HANDLER, str(feed), str(port)],
        "inetdCompatibility": {"Wait": False},
        "Sockets": {"Listener": {"SockNodeName": "127.0.0.1", "SockServiceName": str(port), "SockType": "stream",
                                 "SockFamily": "IPv4"}},
        "StandardErrorPath": "/dev/null",
        "ProcessType": "Background",
    })


def main(argv):
    p = argparse.ArgumentParser(prog="Scripts/dev-feed", description=__doc__.split("\n")[0])
    p.add_argument("command", choices=["publish", "join", "rollback", "leave", "status", "serve"])
    p.add_argument("--feed", type=Path, default=REAL_FEED)
    p.add_argument("--port", type=int, default=REAL_PORT)
    p.add_argument("--app", type=Path, default=REAL_APP)
    keys = p.add_mutually_exclusive_group()
    keys.add_argument("--release-key", action="store_true", help="sign with Sparkle's release key from the login Keychain (the real run)")
    keys.add_argument("--key-file", help="sign with this throwaway seed file instead (a proof; no Pilot accepts it)")
    p.add_argument("--asked-for-branch", metavar="BRANCH", help="publish HEAD's branch build: Sven asked for this branch's build")
    p.add_argument("--notes", help="what is in the batch, one line each")
    p.add_argument("--built", type=Path, help="publish this bundle, already built from HEAD, instead of building")
    p.add_argument("--install", action="store_true")
    p.add_argument("--uninstall", action="store_true")
    a = p.parse_args(argv)
    if a.command == "publish" and not (a.release_key or a.key_file):
        p.error("publish signs with --release-key or a throwaway --key-file; it never picks one itself")
    a.feed, a.app = a.feed.expanduser(), a.app.expanduser()
    try:
        resolve(a)
        {"publish": publish, "join": join, "rollback": rollback, "leave": leave, "status": status,
         "serve": serve}[a.command](a, a.feed)
    except Refused as e:
        print(f"refused: {e}", file=sys.stderr)
        return 1
    except subprocess.CalledProcessError as e:
        print(f"failed: {' '.join(map(str, e.cmd))[:200]}\n{(e.stderr or '').strip()[-800:]}", file=sys.stderr)
        return 1
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
